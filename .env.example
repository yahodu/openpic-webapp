# Copy to .env and fill in. NEVER commit real secrets.

# Application environment: development | test | e2e | staging | production
APP_ENV=development

# Public base URL used by server-side code (no trailing slash)
APP_BASE_URL=http://localhost:3000

# HTTP port the web app listens on
PORT=3000

# Comma-separated list of browser origins allowed to call the API
ALLOWED_ORIGINS=http://localhost:3000

# MongoDB connection string (replica set in production)
MONGODB_URI=mongodb://localhost:27017/openpic

# Session/auth signing secret (>= 32 chars in staging/production)
BETTER_AUTH_SECRET=dev-better-auth-secret-0123456789abcdef

# Internal service-to-service API secret (>= 32 chars in staging/production)
INTERNAL_API_SECRET=dev-internal-api-secret-0123456789abcdef

# Shared secret guarding scheduled/cron endpoints (>= 32 chars in staging/production)
CRON_SECRET=dev-cron-secret-0123456789abcdefghijklmnop

# Secret used to sign unsubscribe links (>= 32 chars in staging/production)
UNSUBSCRIBE_SIGNING_SECRET=dev-unsubscribe-signing-secret-0123456789ab

# Current media URL signing secret (>= 32 chars in staging/production)
MEDIA_SIGNING_SECRET_CURRENT=dev-media-signing-secret-0123456789abcdef

# Optional previous media signing secret, for key rotation (>= 32 chars when set)
MEDIA_SIGNING_SECRET_PREVIOUS=dev-media-signing-secret-previous-0123456789

# Log level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Comma-separated log transport list: stdout | file
LOG_TRANSPORTS=stdout

# Pretty-print logs (true | false)
LOG_PRETTY=false

# Rate limit backend: memory | redis
RATE_LIMIT_PROVIDER=memory

# Object storage backend: memory | s3
STORAGE_PROVIDER=memory

# Background queue backend: memory | mongo
QUEUE_PROVIDER=memory

# Payment backend: memory | stripe
PAYMENT_PROVIDER=memory

# Outbound message transport: memory | ses
MESSAGE_TRANSPORT=memory
